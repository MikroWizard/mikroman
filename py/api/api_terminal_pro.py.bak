# Connect to the same Redis instance used by the rest of the backend
def _get_redis():
    try:
        if hasattr(config, 'SESSION_REDIS') and config.SESSION_REDIS:
            return config.SESSION_REDIS
    except Exception:
        pass
    try:
        return config.flask_config["SESSION_REDIS"]
    except Exception:
        pass
    try:
        _rhost = getattr(config, "redishost", "127.0.0.1:6379")
        _rpass = config.srvconf.get("PYSRV_REDIS_PASSWORD", "")
        if _rpass:
            return redis.from_url(f"redis://:{quote(str(_rpass))}@{_rhost}/0")
        return redis.from_url(f"redis://{_rhost}")
    except Exception:
        return None

r = _get_redis()
log.info(f"api_terminal_pro loaded, Redis: {r.connection_pool.connection_kwargs.get('host')}:{r.connection_pool.connection_kwargs.get('port')}")

terminal_pro_api = Blueprint('terminal_pro_api', __name__)


def _license_blocked():
    """Return an error response if Pro license is expired, invalid, or missing."""
    if not utilpro or not utilpro.check_license_dev_limit_exp():
        return buildResponse({
            'status': 'failed',
            'error': 'License expired or invalid. Terminal Gateway and Connection Manager are Pro features.'
        }, 200, error="License Expired")
    return None

@terminal_pro_api.route('/api/terminal/agent-install-command', methods=['GET'])
@login_required()
def agent_install_command():
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    device_id = request.args.get('device_id')
    
    if not device_id:
        return buildResponse({"status": "failed", "error": "device_id is required"}, 400)
        
    if user.role == 'customer':
        user_devices = DevUserGroupPermRel.get_user_devices(user.id)
        dev = user_devices.where(db_device.Devices.id == device_id).get_or_none()
    else:
        dev = db_device.Devices.get_or_none(db_device.Devices.id == device_id)
        
    if not dev:
        return buildResponse({"status": "failed", "error": "Device not found or access denied"}, 403)
        
    peer_ip = getattr(dev, "peer_ip", "")
    if not peer_ip:
        
        peer_ip = db_sysconfig.get_sysconfig('system_url')
        if not peer_ip:
            peer_ip = db_sysconfig.get_sysconfig('default_ip')
            
    # Remove any trailing slashes or http prefixes if it's just an IP
    # But system_url might have https://. 
    # Let's ensure it has a scheme.
    if peer_ip and not peer_ip.startswith("http"):
        peer_ip = f"https://{peer_ip}"
        
    # Assuming the gateway is served under /agent via nginx proxy, or port 8201
    # We will use the standard Nginx proxy path /agent/install.sh
    # If the user has a custom port, they can edit it manually.
    base_url = peer_ip.rstrip('/')
    install_url = f"{base_url}/agent/install.sh"
    
    command = f"curl -sSL {install_url} | sudo bash"
    
    return buildResponse({
        "status": "success",
        "command": command,
        "install_url": install_url
    }, 200)


@terminal_pro_api.route('/api/terminal/init', methods=['POST'])
@login_required()
def init_terminal():
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    input_data = request.json

    # PAM seat gate: every user (incl. admin) must have terminal access enabled
    if utilpro and not utilpro.is_user_pam_enabled(user.id):
        return buildResponse({
            "status": "pam_required",
            "error": "PAM access is not enabled for this user. Please ask your admin to enable a PAM seat."
        }, 200)

    device_id = input_data.get('device_id')
    protocol = input_data.get('connection_type') or input_data.get('protocol')
    if not protocol:
        default_conn = DeviceConnections.get_or_none(
            DeviceConnections.device_id == device_id,
            DeviceConnections.is_default == True,
            DeviceConnections.protocol != 'api'
        )
        if not default_conn:
            default_conn = (
                DeviceConnections.get_or_none(DeviceConnections.device_id == device_id, DeviceConnections.protocol == 'ssh')
                or DeviceConnections.get_or_none(DeviceConnections.device_id == device_id, DeviceConnections.protocol == 'telnet')
            )
        protocol = (default_conn.protocol if default_conn else 'ssh')
    protocol = protocol.lower()
    canonical_protocol = 'winbox' if protocol in ('winbox', 'webbox') else protocol

    if not device_id:
        return buildResponse({"status": "failed", "error": "device_id is required"}, 400)

    if user.role == 'customer':
        user_devices = DevUserGroupPermRel.get_user_devices(user.id)
        dev = user_devices.where(db_device.Devices.id == device_id).get_or_none()
    else:
        dev = db_device.Devices.get_or_none(db_device.Devices.id == device_id)
    if not dev:
        return buildResponse({"status": "failed", "error": "Device not found or access denied"}, 403)

    is_mikrotik = getattr(dev, 'device_type', 'mikrotik') == 'mikrotik'
    if canonical_protocol == 'winbox' and not is_mikrotik:
        return buildResponse({"status": "failed", "error": "WebBox is only supported on MikroTik devices."}, 400)

    # Terminal gateway capability check
    if canonical_protocol == 'winbox':
        webbox_ok, reason = terminal_gateway.is_webbox_supported()
        if not webbox_ok:
            if reason == 'not_installed':
                return buildResponse({
                    "status": "gateway_not_installed",
                    "error": "Terminal Gateway is not installed. Please ask your administrator to install the terminal gateway addon.",
                    "doc_url": "https://mikrowizard.com/docs/installing-terminal-gatway-addon/"
                }, 200)
            else:
                return buildResponse({
                    "status": "gateway_update_required",
                    "error": "Your Terminal Gateway container is outdated and does not support WebBox. Please update the Terminal Gateway Docker container to the latest version to use this feature.",
                    "doc_url": "https://mikrowizard.com/docs/updating-terminal-gateway-addon/"
                }, 200)
    else:
        if not terminal_gateway.is_terminal_gateway_installed():
            return buildResponse({
                "status": "gateway_not_installed",
                "error": "Terminal Gateway is not installed. Please ask your administrator to install the terminal gateway addon.",
                "doc_url": "https://mikrowizard.com/docs/installing-terminal-gatway-addon/"
            }, 200)

    # Check parent/child relationship
    parent_dev = None
    if getattr(dev, 'parent_id', None):
        parent_dev = db_device.Devices.get_or_none(db_device.Devices.id == dev.parent_id)
    host_dev = parent_dev if parent_dev else dev
    effective_ip = (host_dev.ip or host_dev.peer_ip or '').strip()

    # Resolve DeviceConnections (PAM) for port + privileged credential
    try:
        conn = DeviceConnections.get(
            DeviceConnections.device_id == device_id,
            DeviceConnections.protocol == protocol
        )
    except DeviceConnections.DoesNotExist:
        if parent_dev:
            try:
                conn = DeviceConnections.get(
                    DeviceConnections.device_id == parent_dev.id,
                    DeviceConnections.protocol == protocol
                )
            except DeviceConnections.DoesNotExist:
                conn = None
        else:
            conn = None

    default_ports = {'ssh': 22, 'telnet': 23, 'winbox': 8291, 'rdp': 3389, 'vnc': 5900}
    port = conn.port if (conn and conn.port) else default_ports.get(canonical_protocol, 22)

    session_id = str(uuid.uuid4())
    if canonical_protocol == 'winbox':
        token = f"winbox-{secrets.token_hex(16)}"
    elif canonical_protocol == 'rdp':
        token = f"rdp-{secrets.token_hex(16)}"
    elif canonical_protocol == 'vnc':
        token = f"vnc-{secrets.token_hex(16)}"
    elif canonical_protocol == 'telnet':
        token = f"telnet-{secrets.token_hex(16)}"
    else:
        token = f"ssh-{secrets.token_hex(16)}"

    # User credential with temporary password (WebFig parity via RADIUS)
    try:
        radius_enabled = bool(db_sysconfig.get_sysconfig("Radius") == "1" or db_sysconfig.get_sysconfig("force_radius"))
    except Exception:
        radius_enabled = False

    conn_type = getattr(conn, 'connection_type', 'device') if conn else 'device'
    use_user_cred = (canonical_protocol == 'winbox' and is_mikrotik and radius_enabled and utilpro and nt_password_hash) or (conn_type == 'user')

    cred = None
    if use_user_cred and UserPoro:
        try:
            up = UserPoro.get_or_none(UserPoro.id == user.id)
            if up:
                temp_pass = utilpro.generate_password(12)
                nthashhex = ''.join(list("{:02x}".format(ord(c)) for c in nt_password_hash(temp_pass)))
                up.temp_hash = nthashhex
                up.user_proxy_ip = get_ip()
                up.save()
                if r:
                    r.setex(f"proxy_temp_hash:{nthashhex}", 600, session_id)
                cred = {
                    'method': 'credential',
                    'username': up.username,
                    'password': temp_pass,
                    'auth_method': 'password'
                }
                log.info(f"Generated WebBox temporary password for user {user.username} on device {device_id}")
        except Exception as e:
            log.warning(f"Failed to generate temporary password for WebBox: {e}")

    if not cred:
        cred = CredentialService.get_credential_for_connection(device_id, protocol, user.id)
        if (not cred or cred.get('method') != 'credential') and parent_dev:
            cred = CredentialService.get_credential_for_connection(parent_dev.id, protocol, user.id)
            if not cred or cred.get('method') != 'credential':
                for fb in ('rdp', 'ssh'):
                    cred = CredentialService.get_credential_for_connection(parent_dev.id, fb, user.id)
                    if cred and cred.get('method') == 'credential':
                        break
        if (not cred or cred.get('method') != 'credential') and canonical_protocol == 'winbox' and is_mikrotik:
            cred = CredentialService.get_credential_for_connection(device_id, 'webfig', user.id)
            if not cred or cred.get('method') != 'credential':
                cred = CredentialService.get_credential_for_connection(device_id, 'ssh', user.id)

    # Self-healing auto-sync: if no credential found in the new table, migrate from old devices table
    if (not cred or cred.get('method') != 'credential') and dev.password:
        try:
            dec_pass = util.decrypt_data(dev.password)
            if dec_pass:

                
                dec_user = util.decrypt_data(dev.user_name) if dev.user_name else "admin"

                # Find all device-scoped credentials for this device
                creds = list(Credentials.select().where(
                    Credentials.device_id == dev.id,
                    Credentials.scope == 'device'
                ))

                kek = kek_provider.get_kek()
                enc_bundle = envelope_crypto.full_encrypt(dec_pass, kek)

                if creds:
                    # Update all existing device credentials
                    for cred in creds:
                        cred.username = dec_user
                        cred.encrypted_password = enc_bundle['encrypted_payload']
                        cred.dek_encrypted = enc_bundle['dek_encrypted']
                        cred.modified = datetime.datetime.now(datetime.timezone.utc)
                        cred.save()
                else:
                    # Create default connection credentials
                    is_mikrotik = getattr(dev, 'device_type', 'mikrotik') == 'mikrotik'
                    types_to_create = ["webfig", "ssh"] if is_mikrotik else ["ssh", "telnet"]
                    for t in types_to_create:
                        Credentials.create(
                            name=f"Device {dev.id} Auto-Sync {t.upper()} Credential",
                            credential_type=t,
                            username=dec_user,
                            encrypted_password=enc_bundle['encrypted_payload'],
                            dek_encrypted=enc_bundle['dek_encrypted'],
                            auth_method="password",
                            scope="device",
                            device_id=dev.id,
                            owner_id=dev.owner,
                            created=datetime.datetime.now(datetime.timezone.utc),
                            modified=datetime.datetime.now(datetime.timezone.utc)
                        )
                
                log.info(f"Self-healed: successfully synced credential for device {device_id} on-the-fly.")
                # Re-resolve
                cred = CredentialService.get_credential_for_connection(device_id, protocol, user.id)
        except Exception as sync_err:
            log.error(f"On-the-fly credential sync failed: {sync_err}")

    if not cred or cred.get('method') != 'credential':
        return buildResponse({"status": "failed", "error": "No credential found for this device"}, 404)

    # Build payload
    session_payload = {
        "token": token,
        "device_ip": effective_ip or dev.ip,
        "device_port": int(port),
        "username": cred.get('username'),
        "password": util.crypt_data(cred['password']) if cred.get('password') else "",
        "protocol": canonical_protocol,
        "session_id": session_id,
        "user_id": str(user.id),
        "device_id": device_id,
        "device_brand": dev.device_type,
        "participant_role": "owner",
        "auth_method": cred.get('auth_method', 'password'),
        "resolution": input_data.get('resolution', 'auto')
    }

    # SSH key auth
    if cred.get('ssh_key'):
        session_payload['ssh_key'] = util.crypt_data(cred['ssh_key'])
        if cred.get('ssh_key_passphrase'):
            session_payload['ssh_key_passphrase'] = util.crypt_data(cred['ssh_key_passphrase'])

    # Privilege escalation (enable_password)
    if conn and conn.privileged_credential_id:
        try:
            kek = kek_provider.get_kek()
            enable_secret = envelope_crypto.full_decrypt(
                conn.privileged_credential_id.encrypted_password,
                conn.privileged_credential_id.dek_encrypted,
                kek
            )
            session_payload['enable_password'] = util.crypt_data(enable_secret)
        except Exception as e:
            log.error(f"Failed to decrypt enable credential for device {device_id}: {e}")

    # Template-driven escalation metadata for the terminal gateway. The gateway
    # uses this instead of a hardcoded "enable", and only sends the escalation
    # password after the device prompts for it (password_prompt). Normalize the
    # canonical schema (command/password_prompt/success_pattern) with fallbacks
    # for legacy templates that only store {command, prompt}.
    try:
        template = TemplateService.get_template_for_device(device_id) or {}
    except Exception as e:
        log.error(f"Failed to load template for device {device_id}: {e}")
        template = {}
    priv = template.get("privilege_escalation") or {}
    if isinstance(priv, dict) and priv.get("command"):
        prompt_cfg = template.get("prompt") or {}
        if not isinstance(prompt_cfg, dict):
            prompt_cfg = {}
        session_payload["privilege_escalation"] = {
            "command": priv.get("command"),
            "password_prompt": priv.get("password_prompt")
                               or prompt_cfg.get("password_pattern")
                               or r"[Pp]assword:?",
            "success_pattern": priv.get("success_pattern") or priv.get("prompt") or "",
        }

    # Enforce policy grant: device must belong to a group AND user must have
    # DevUserGroupPermRel access to that group, AND a TerminalGrantPolicyPro
    # mapping for that group, otherwise reject the session.
    rel = DevGroupRel.get_or_none(DevGroupRel.device_id == device_id)
    if not rel and parent_dev:
        rel = DevGroupRel.get_or_none(DevGroupRel.device_id == parent_dev.id)

    user_group_perms = list(DevUserGroupPermRel.select().where(DevUserGroupPermRel.user_id == user.id))
    has_default_access = any(perm.group_id.id == 1 for perm in user_group_perms)

    if rel:
        group_id = rel.group_id
        group_id_int = group_id.id if hasattr(group_id, "id") else group_id
        if not (has_default_access or any(perm.group_id.id == group_id_int for perm in user_group_perms)):
            return buildResponse(
                {"status": "failed", "error": "You do not have access to this device's group."},
                200
            )
    else:
        # No explicit group → the device lives in the virtual default group (id=1,
        # "all devices"). Enforce via the default group only when the user has
        # default-group access (a group-1 policy is still required below).
        if not has_default_access:
            return buildResponse(
                {"status": "failed", "error": "Device is not assigned to any group. No terminal policy can be enforced."},
                200
            )
        group_id = 1
        group_id_int = 1

    device_brand = dev.device_type or ''

    try:
        grant = TerminalGrantPolicyPro.get(
            TerminalGrantPolicyPro.user_id == user.id,
            TerminalGrantPolicyPro.group_id == group_id
        )
    except TerminalGrantPolicyPro.DoesNotExist:
        # If the user has default group access, also try the default group's policy.
        grant = None
        if has_default_access and group_id_int != 1:
            try:
                grant = TerminalGrantPolicyPro.get(
                    TerminalGrantPolicyPro.user_id == user.id,
                    TerminalGrantPolicyPro.group_id == 1
                )
            except TerminalGrantPolicyPro.DoesNotExist:
                pass
        if not grant:
            return buildResponse(
                {"status": "failed", "error": "No terminal policy is set for this device group. Please ask your administrator to configure a terminal policy."},
                200
            )

    # Resolve policy: check brand_map first, fall back to default policy_id
    policy = None
    if grant.brand_map and device_brand in grant.brand_map:
        try:
            brand_policy_id = grant.brand_map[device_brand]
            policy = TerminalPolicyPro.get(id=brand_policy_id)
        except TerminalPolicyPro.DoesNotExist:
            pass
    if not policy:
        policy = grant.policy_id
    policy_obj = {
        "id": str(policy.id),
        "defense": {
            "level": policy.defense_level or "standard",
            "blocked_binaries": policy.blocked_binaries or [],
        },
        "agent_modes": policy.agent_modes,
    }
    if policy.policy_type == "auto_exec":
        policy_obj["type"] = "auto_exec"
        policy_obj["commands"] = [r["rule"] for r in (policy.rules or []) if r.get("rule")]
    elif policy.policy_type == "blacklist":
        policy_obj["type"] = "allow_all"
        policy_obj["matching"] = policy.matching
        policy_obj["rules"] = policy.rules
        session_payload["default_action"] = "allow"
    else:  # whitelist
        policy_obj["type"] = "whitelist"
        policy_obj["matching"] = policy.matching
        policy_obj["rules"] = policy.rules
        session_payload["default_action"] = "deny"
    session_payload['policies'] = [policy_obj]

    # Phase C agent: top-level flag + per-device override
    session_payload['agent_modes'] = policy.agent_modes
    if conn and conn.agent_modes is not None:
        session_payload['device_agent_modes'] = conn.agent_modes

    # -------------------------------------------------------------------------
    # 4-Tier Cascading Hierarchy for RDP / VNC Guacamole Options & Session DLP
    # -------------------------------------------------------------------------
    guac_options = {}

    # Tier 1: Connection Template (Display, Performance, Layout)
    eff_tpl_id = getattr(dev, 'template_id', None) or (getattr(host_dev, 'template_id', None) if parent_dev else None)
    tpl_data = None
    if eff_tpl_id:
        tpl_data = TemplateService.get_template_by_id(eff_tpl_id)
    if not tpl_data:
        tpl_data = TemplateService.get_template_for_device(dev.id) or (TemplateService.get_template_for_device(host_dev.id) if parent_dev else None)

    if tpl_data and tpl_data.get('connection'):
        for k, v in tpl_data['connection'].items():
            if k not in ('protocol', 'protocols', 'port'):
                guac_options[k] = v

    # Tier 2: Parent Device (Host) Overrides & Domain
    host_pcfg = getattr(host_dev, 'protocol_config', None) or {}
    if isinstance(host_pcfg, dict):
        if host_pcfg.get('domain'):
            session_payload['domain'] = host_pcfg['domain']
        if isinstance(host_pcfg.get('overrides'), dict):
            for k, v in host_pcfg['overrides'].items():
                guac_options[k] = v

    # Tier 3: Child Application Definition & Overrides
    if parent_dev:
        child_pcfg = getattr(dev, 'protocol_config', None) or {}
        if isinstance(child_pcfg, dict):
            app_mode = child_pcfg.get('app_mode', 'remote_app')
            if app_mode == 'initial_program':
                if child_pcfg.get('initial_program'):
                    guac_options['initial-program'] = child_pcfg['initial_program']
            else:
                if child_pcfg.get('remote_app'):
                    guac_options['remote-app'] = child_pcfg['remote_app']
                if child_pcfg.get('remote_app_dir'):
                    guac_options['remote-app-dir'] = child_pcfg['remote_app_dir']
                if child_pcfg.get('remote_app_args'):
                    guac_options['remote-app-args'] = child_pcfg['remote_app_args']

            if isinstance(child_pcfg.get('overrides'), dict):
                for k, v in child_pcfg['overrides'].items():
                    guac_options[k] = v

    # Tier 4: Session DLP Policy (Supreme Security Authority)
    session_dlp = getattr(policy, 'session_dlp', None)
    if not isinstance(session_dlp, dict):
        session_dlp = {
            "clipboard": "bidirectional",
            "file_transfer": "enabled",
            "watermark": {"enabled": False, "text": "{user} ({ip}) - {date}", "opacity": 0.15},
            "recording": {"video_enabled": True, "keystrokes_enabled": True},
            "printing": False,
            "audio_input": False
        }

    # DLP - Clipboard
    clip_setting = session_dlp.get('clipboard', 'bidirectional')
    if clip_setting == 'blocked':
        guac_options['disable-copy'] = 'true'
        guac_options['disable-paste'] = 'true'
    elif clip_setting == 'read_only':
        guac_options['disable-copy'] = 'false'
        guac_options['disable-paste'] = 'true'
    elif clip_setting == 'write_only':
        guac_options['disable-copy'] = 'true'
        guac_options['disable-paste'] = 'false'
    else:  # bidirectional
        guac_options['disable-copy'] = 'false'
        guac_options['disable-paste'] = 'false'

    # DLP - File Transfer (Web Drive)
    ft_setting = session_dlp.get('file_transfer', 'enabled')
    if ft_setting == 'blocked':
        guac_options['enable-drive'] = 'false'
        guac_options.pop('drive-name', None)
        guac_options.pop('drive-path', None)
    else:
        guac_options['enable-drive'] = 'true'
        if not guac_options.get('drive-name'):
            guac_options['drive-name'] = 'MikroWizard Shared Drive'

    # DLP - Printing & Audio Input
    guac_options['enable-printing'] = 'true' if session_dlp.get('printing') else 'false'
    guac_options['enable-audio-input'] = 'true' if session_dlp.get('audio_input') else 'false'

    # DLP - Video Recording
    rec_cfg = session_dlp.get('recording') or {}
    session_payload['video_recording_enabled'] = rec_cfg.get('video_enabled', True)

    session_payload['options'] = guac_options
    session_payload['session_dlp'] = session_dlp
    session_payload['remote_app'] = guac_options.get('remote-app') or guac_options.get('initial-program') or ''

    # Store payload in Redis with 120 second TTL (gives browser time to open WebSocket)
   
    if os.getenv("DEV_MODE") == "true":
        log.info(f"[DEV_MODE] Storing credential: user={cred.get('username')}, pass={cred.get('password')}, key={cred.get('ssh_key') is not None}")
    log.info(f"Writing to Redis: key=terminal_session:{token}")
    r.setex(f"terminal_session:{token}", 120, json.dumps(session_payload))
    log.info(f"Successfully stored token {token} in Redis. Payload sample: device_ip={session_payload.get('device_ip')}")

    # Store session record in DB
    TerminalSessionPro.create(
        id=session_id,
        device_id=device_id,
        user_id=user.id,
        client_ip=get_ip(),
        token=token,
        started=datetime.datetime.now(),
        device_brand=dev.device_type
    )

    # MikroTik devices emit syslog login/logout events for the gateway's device
    # account, which would otherwise appear as confusing "local user" rows in the
    # auth table. Attribute the session to the real customer and track it so the
    # syslog handler can suppress the router's own duplicate events.
    if getattr(dev, 'device_type', 'mikrotik') == 'mikrotik':
        cred_username = (cred.get('username') or '').strip()
        if AuthPro is not None:
            try:
                AuthPro.attach_terminal_log(
                    devid=device_id,
                    username=user.username,
                    ip=get_ip(),
                    sessionid=session_id,
                    cred_username=cred_username,
                    protocol=protocol
                )
            except Exception as e:
                log.error(f"Failed to attach terminal auth log for device {device_id}: {e}")
        if cred_username:
            try:
                r.sadd(f"terminal_gw_active:{device_id}:{cred_username}", session_id)
                r.setex(
                    f"terminal_gw_meta:{session_id}", 172800,
                    json.dumps({"device_id": device_id, "cred_username": cred_username})
                )
            except Exception as e:
                log.error(f"Failed to track terminal gateway session in Redis: {e}")

    if canonical_protocol == 'winbox':
        web_url = f"/terminal-ws/winbox.html?token={token}"
    elif canonical_protocol in ('rdp', 'vnc'):
        web_url = f"/terminal-ws/desktop.html?token={token}"
    else:
        web_url = f"/terminal-ws/?token={token}"
    return buildResponse({"status": "success", "token": token, "session_id": session_id, "protocol": canonical_protocol, "web_url": web_url})


@terminal_pro_api.route('/api/terminal/session/join', methods=['POST'])
@login_required()
def join_session():
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    session_id = request.json.get('session_id')
    role = request.json.get('role', 'observer')  # or 'collaborator'

    if not session_id:
        return buildResponse({"status": "failed", "error": "session_id required"}, 400)

    try:
        session = TerminalSessionPro.get(id=session_id)
        if session.status != 'active':
            return buildResponse({"status": "failed", "error": "Session is not active"}, 400)

        # Check if user has permission to join this device
        if user.role == 'customer':
            
            dev = DevUserGroupPermRel.get_user_devices(user.id).where(
                db_device.Devices.id == session.device_id
            ).get_or_none()
        else:
            dev = db_device.Devices.get_or_none(db_device.Devices.id == session.device_id)
        if not dev:
            return buildResponse({"status": "failed", "error": "Access denied to this device"}, 403)

        token = str(uuid.uuid4())

        is_winbox = bool(session.token and ('winbox' in session.token))
        is_telnet = bool(session.token and ('telnet' in session.token))
        join_protocol = 'winbox' if is_winbox else ('telnet' if is_telnet else 'ssh')
        user_name = f"{user.first_name or ''} {user.last_name or ''}".strip() or user.username

        join_payload = {
            "session_id": session_id,
            "participant_role": role,
            "participant_name": user_name,
            "protocol": join_protocol,
            "user_id": str(user.id)
        }

        r.setex(f"terminal_session:{token}", 120, json.dumps(join_payload))

        # Record participant
        SessionParticipantPro.create(
            session_id=session_id,
            user_id=user.id,
            token=token,
            role=role,
            participant_name=user_name,
            joined_at=datetime.datetime.now(),
            client_ip=get_ip()
        )

        return buildResponse({"status": "success", "token": token})
    except TerminalSessionPro.DoesNotExist:
        return buildResponse({"status": "failed", "error": "Session not found"}, 404)


@terminal_pro_api.route('/api/terminal/logs/search', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "read"})
def search_terminal_logs():
    """Paginated search for command logs."""
    user = get_myself()
    if user.role != 'admin':
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    blocked = _license_blocked()
    if blocked:
        return blocked

    limit = int(request.json.get('limit', 50))
    offset = int(request.json.get('offset', 0))
    device_id = request.json.get('device_id')
    session_id = request.json.get('session_id')
    user_id = request.json.get('user_id')
    is_blocked = request.json.get('is_blocked')
    date_from = request.json.get('date_from')
    date_to = request.json.get('date_to')

    query = TerminalCommandPro.select()
    if device_id:
        query = query.where(TerminalCommandPro.device_id == device_id)
    if user_id:
        query = query.where(TerminalCommandPro.user_id == user_id)
    if session_id:
        query = query.where(TerminalCommandPro.session_id == session_id)
    if is_blocked is not None:
        query = query.where(TerminalCommandPro.is_blocked == is_blocked)
    if date_from:
        query = query.where(TerminalCommandPro.timestamp >= date_from)
    if date_to:
        query = query.where(TerminalCommandPro.timestamp <= date_to)

    query = query.order_by(TerminalCommandPro.timestamp.desc()).limit(limit).offset(offset)

    logs = list(query.dicts())
    for log in logs:
        u = User.get_or_none(id=log['user_id']) if 'user_id' in log and log['user_id'] else None
        log['user_name'] = f"{u.first_name} {u.last_name}" if u else log.get('user_id', 'Unknown')
        
        d = db_device.Devices.get_or_none(id=log['device_id']) if 'device_id' in log and log['device_id'] else None
        log['device_name'] = d.name if d else str(log.get('device_id', 'Unknown'))
        log['device_ip'] = d.ip if d else "Unknown IP"
        
        # Ensure timestamp is formatted if it's a datetime object
        if hasattr(log.get('timestamp'), 'strftime'):
            log['timestamp_fmt'] = log['timestamp'].strftime('%Y-%m-%d %H:%M:%S')

    return buildResponse({"status": "success", "data": logs})


@terminal_pro_api.route('/api/terminal/settings', methods=['GET', 'POST'])
@login_required()
def terminal_settings():
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()

    if request.method == 'GET':
        try:
            settings = TerminalUserSettingPro.get(user_id=user.id)
            return buildResponse({"status": "success", "data": settings.__data__})
        except TerminalUserSettingPro.DoesNotExist:
            return buildResponse({"status": "success", "data": {}})

    elif request.method == 'POST':
        data = request.json
        data['updated_at'] = datetime.datetime.now()

        try:
            settings = TerminalUserSettingPro.get(user_id=user.id)
            for k, v in data.items():
                if hasattr(settings, k):
                    setattr(settings, k, v)
            settings.save()
        except TerminalUserSettingPro.DoesNotExist:
            data['user_id'] = user.id
            TerminalUserSettingPro.create(**data)

        return buildResponse({"status": "success"})



def _detect_session_protocol(s):
    """Accurately determine connection protocol (rdp, vnc, winbox, telnet, ssh)."""
    tok = (s.get('token') if isinstance(s, dict) else getattr(s, 'token', '')) or ''
    rec = (s.get('recording_path') if isinstance(s, dict) else getattr(s, 'recording_path', '')) or ''

    if tok.startswith('winbox-') or 'winbox' in tok:
        return 'winbox'
    if tok.startswith('rdp-') or 'rdp' in tok:
        return 'rdp'
    if tok.startswith('vnc-') or 'vnc' in tok:
        return 'vnc'
    if tok.startswith('telnet-') or 'telnet' in tok:
        return 'telnet'
    if tok.startswith('ssh-'):
        return 'ssh'

    # Check active session cached in Redis
    if tok:
        try:
            raw_s = r.get(f"terminal_session:{tok}")
            if raw_s:
                p = json.loads(raw_s).get('protocol')
                if p:
                    return p.lower()
        except Exception:
            pass

    # Check recording path extension
    if rec.endswith('.guac'):
        return 'rdp'
    if rec.endswith('.mp4'):
        return 'winbox'
    if rec.endswith('.cast'):
        return 'ssh'

    # Legacy desktop token
    if tok.startswith('desktop-'):
        return 'rdp'

    # Fallback to DeviceConnections if device_id is available
    device_id = s.get('device_id') if isinstance(s, dict) else getattr(s, 'device_id', None)
    if device_id:
        try:
            conns = list(DeviceConnections.select().where(DeviceConnections.device_id == device_id))
            if conns:
                for c in conns:
                    if c.protocol in ('rdp', 'vnc', 'winbox', 'telnet'):
                        return c.protocol.lower()
        except Exception:
            pass

    return 'ssh'

# ==================================================
# Session Management — Admin Endpoints (Phase 4)
# ==================================================

@terminal_pro_api.route('/api/terminal/sessions/list', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "read"})
def admin_list_sessions():
    """List all active sessions with user/device info, paginated. Admin-only."""
    user = get_myself()
    log.info(f"[WebFig Debug admin_list_sessions ENTRY] user={user.id if user else None}, json={request.json}")
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    blocked = _license_blocked()
    if blocked:
        return blocked
    page = int(request.json.get('page', 1))
    limit = int(request.json.get('limit', 50))
    status_filter = request.json.get('status')
    device_id = request.json.get('device_id')
    user_id = request.json.get('user_id')
    
    q = TerminalSessionPro.select()
    if status_filter:
        q = q.where(TerminalSessionPro.status == status_filter)
    if device_id:
        q = q.where(TerminalSessionPro.device_id == device_id)
    if user_id:
        q = q.where(TerminalSessionPro.user_id == user_id)
        
    total = q.count()
    sessions = list(q.order_by(TerminalSessionPro.started.desc()).paginate(page, limit).dicts())
    log.info(f"[WebFig Debug admin_list_sessions] DB TerminalSessionPro count={total}, fetched={len(sessions)}")
    for s in sessions:
        u = User.get_or_none(id=s['user_id'])
        s['user_name'] = f"{u.first_name} {u.last_name}" if u else s['user_id']
        s['username'] = u.username if u else ''
        
        d = db_device.Devices.get_or_none(id=s['device_id'])
        s['device_name'] = d.name if d else str(s['device_id'])
        s['device_ip'] = d.ip if d else "Unknown IP"
        
        s['protocol'] = _detect_session_protocol(s)
        
        participants_query = SessionParticipantPro.select().where(SessionParticipantPro.session_id == str(s['id']))
        if s['status'] == 'active':
            participants_query = participants_query.where(SessionParticipantPro.is_connected == True)
        
        active_participants = list(participants_query)
        
        participant_details = []
        for p in active_participants:
            username = ''
            name = (p.participant_name or '').strip()
            if p.user_id:
                try:
                    pu = User.get_or_none(id=p.user_id)
                    if pu:
                        full_name = f"{pu.first_name or ''} {pu.last_name or ''}".strip()
                        name = full_name or pu.username or name
                        username = pu.username or ''
                except Exception:
                    pass
            elif p.role != 'owner':
                if name and name.lower() != 'guest':
                    name = name if name.lower().endswith('(guest)') else f"{name} (Guest)"
                else:
                    name = "Guest"
            if not name:
                name = "Owner" if p.role == 'owner' else "Guest"

            participant_details.append({
                "name": name,
                "username": username,
                "role": p.role,
                "ip": p.client_ip or "Unknown IP",
                "agent": p.user_agent or "Unknown Agent",
                "joined_at": p.joined_at.isoformat() if getattr(p, 'joined_at', None) else None,
                "disconnected_at": p.disconnected_at.isoformat() if getattr(p, 'disconnected_at', None) else None,
                "is_connected": getattr(p, 'is_connected', False)
            })

        s['participants'] = participant_details
        s['participant_count'] = len(participant_details)
        
    # Include active WebFig proxy sessions from Redis
    if not status_filter or status_filter == 'active':
        try:
            r_client = _get_redis()
            if not r_client:
                log.warning("[WebFig Debug admin_list_sessions] r_client is NONE!")
            else:
                keys = r_client.keys("proxy_session:*")
                log.info(f"[WebFig Debug admin_list_sessions] Found {len(keys)} proxy_session keys in Redis: {keys}")
                for k in keys:
                    raw = r_client.get(k)
                    log.info(f"[WebFig Debug admin_list_sessions] Redis key={k}, raw_type={type(raw)}, raw_val={raw}")
                    if not raw:
                        continue
                    sdata = json.loads(raw) if isinstance(raw, str) else json.loads(raw.decode('utf-8'))
                    session_id = k.replace('proxy_session:', '') if isinstance(k, str) else k.decode('utf-8').replace('proxy_session:', '')

                    # Only include sessions with an active heartbeat (active browser tab)
                    has_hb = r_client.exists(f"proxy_heartbeat:{session_id}")
                    log.info(f"[WebFig Debug admin_list_sessions] session_id={session_id}, has_hb={has_hb}")
                    if not has_hb:
                        log.info(f"[WebFig Debug admin_list_sessions] Skipping session_id={session_id} because proxy_heartbeat is missing/expired")
                        continue

                    devid = sdata.get('devid')
                    if device_id and str(devid) != str(device_id):
                        log.info(f"[WebFig Debug admin_list_sessions] Skipping session_id={session_id} due to device_id mismatch: {devid} vs {device_id}")
                        continue
                    userid = sdata.get('userid')
                    if user_id and str(userid) != str(user_id):
                        log.info(f"[WebFig Debug admin_list_sessions] Skipping session_id={session_id} due to user_id mismatch: {userid} vs {user_id}")
                        continue
                    log.info(f"[WebFig Debug admin_list_sessions] Appending WebFig active session_id={session_id} to results!")
                    
                    started_ts = sdata.get('started_at', int(time.time()))
                    started_dt = datetime.datetime.fromtimestamp(started_ts)
                    
                    dev = db_device.Devices.get_or_none(id=devid) if devid else None
                    user_obj = User.get_or_none(id=userid) if userid else None
                    
                    u_fullname = f"{user_obj.first_name} {user_obj.last_name}".strip() if (user_obj and (user_obj.first_name or user_obj.last_name)) else (user_obj.username if user_obj else "WebFig User")
                    dev_name = dev.name if dev else f"CHR-Tower01"
                    dev_ip = dev.ip if dev else sdata.get('ip', 'Unknown IP')

                    sessions.append({
                        'id': session_id,
                        'session_id': session_id,
                        'stype': 'webfig',
                        'user_id': str(userid) if userid else None,
                        'user_name': u_fullname,
                        'username': user_obj.username if user_obj else '',
                        'device_id': str(devid) if devid else None,
                        'device_name': dev_name,
                        'device_ip': dev_ip,
                        'protocol': 'webfig',
                        'status': 'active',
                        'started': started_dt.isoformat(),
                        'ended': None,
                        'participant_count': 1,
                        'participants': [{
                            'name': u_fullname,
                            'username': user_obj.username if user_obj else '',
                            'role': 'host',
                            'ip': sdata.get('ip', 'Unknown IP'),
                            'agent': 'WebBrowser'
                        }]
                    })
        except Exception as e:
            log.warning(f"Failed to fetch active webfig sessions: {e}")

    return buildResponse({"status": "success", "data": sessions, "total": len(sessions)})


@terminal_pro_api.route('/api/terminal/sessions/kill', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "full"})
def admin_kill_session():
    """Force-kill a session by ID. Admin-only."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    session_id = request.json.get('session_id')
    if not session_id:
        return buildResponse({"status": "failed", "error": "session_id required"}, 400)
    try:
        session = TerminalSessionPro.get(id=session_id)
        session.status = 'terminated'
        session.ended = datetime.datetime.now()
        session.save()
        # Close the Terminal-Gateway auth row and release syslog suppression
        try:
            if AuthPro is not None:
                AuthPro.close_terminal_log(session_id, ended_timestamp=int(time.time()))
            meta = r.get(f"terminal_gw_meta:{session_id}")
            if meta:
                m = json.loads(meta)
                r.srem(f"terminal_gw_active:{m.get('device_id')}:{m.get('cred_username')}", session_id)
                r.delete(f"terminal_gw_meta:{session_id}")
        except Exception as e:
            log.error(f"Failed to close terminal auth log: {e}")
        # Remove Redis token(s) to force-disconnect
        for participant in SessionParticipantPro.select().where(SessionParticipantPro.session_id == session_id):
            r.delete(f"terminal_session:{participant.token}")
        
        # Publish kill event to gateway
        r.publish("terminal:session:kill", str(session_id))
        
        return buildResponse({"status": "success"})
    except TerminalSessionPro.DoesNotExist:
        return buildResponse({"status": "failed", "error": "Session not found"}, 404)


