@terminal_pro_api.route('/api/terminal/sessions/participants', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "read"})
def admin_session_participants():
    """List participants in a session."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    session_id = request.json.get('session_id')
    if not session_id:
        return buildResponse({"status": "failed", "error": "session_id required"}, 400)
    participants = list(SessionParticipantPro.select()
                       .where(SessionParticipantPro.session_id == str(session_id))
                       .order_by(SessionParticipantPro.joined_at.desc())
                       .dicts())
    for p in participants:
        u = None
        if p.get('user_id'):
            try:
                u = User.get_or_none(id=p['user_id'])
            except Exception:
                pass
        p_name = p.get('participant_name') or ''
        if u:
            full_name = f"{u.first_name or ''} {u.last_name or ''}".strip()
