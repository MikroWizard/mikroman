            p['name'] = p['user_name']
            p['username'] = u.username or ''
        else:
            p['user_name'] = p_name or 'Guest'
            p['name'] = p['user_name']
            p['username'] = ''
    return buildResponse({"status": "success", "data": participants})


@terminal_pro_api.route('/api/terminal/session/share', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "write"})
def share_session():
    """Generate a unique sharing token+URL for a session."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    session_id = request.json.get('session_id')
    role = request.json.get('role', 'observer')
    name = request.json.get('name', '')
    share_type = request.json.get('share_type', 'guest')
    target_user_id = request.json.get('target_user_id')
    guest_password = request.json.get('password')
    one_time = request.json.get('one_time', False)
    host_approval = request.json.get('host_approval', False)

    if not session_id:
        return buildResponse({"status": "failed", "error": "session_id required"}, 400)
    session = TerminalSessionPro.get_or_none(id=session_id)
    if not session:
        return buildResponse({"status": "failed", "error": "Session not found"}, 404)
    token = str(uuid.uuid4())
    proto = _detect_session_protocol(session)
    is_admin_user = bool(user.role in ('admin', 'superuser'))
    if share_type == 'admin' or (is_admin_user and not request.json.get('host_approval')):
        host_approval = False

    is_winbox = (proto == 'winbox')
    is_desktop = (proto in ('rdp', 'vnc'))
    is_telnet = (proto == 'telnet')

    if is_desktop:
        share_url = f"/terminal-ws/desktop.html?token={token}"
        share_protocol = proto
    elif is_winbox:
        share_url = f"/terminal-ws/winbox.html?token={token}"
        share_protocol = 'winbox'
    elif is_telnet:
        share_url = f"/terminal-ws/?token={token}"
        share_protocol = 'telnet'
    else:
        share_url = f"/terminal-ws/?token={token}"
        share_protocol = 'ssh'

    target_user = None
    send_notifications = False
    raw_name = (request.json.get('name') or '').strip()

    if share_type == 'admin':
        target_user = user
        name = f"{user.first_name or ''} {user.last_name or ''}".strip() or user.username
        host_approval = False
    elif share_type == 'user':
        if not target_user_id or str(target_user_id) == str(user.id):
            target_user = user
            host_approval = False
        else:
            target_user = User.get_or_none(id=target_user_id)
            if not target_user:
                return buildResponse({"status": "failed", "error": "Target user not found"}, 404)
            # Automatically enforce host approval for internal user links to prevent unauthorized token reuse
            host_approval = True
            send_notifications = True
        name = f"{target_user.first_name or ''} {target_user.last_name or ''}".strip() or target_user.username
    else:
        if raw_name and raw_name.lower() != 'guest':
            name = raw_name if raw_name.lower().endswith('(guest)') else f"{raw_name} (Guest)"
        else:
            name = "Guest"

    if share_type != 'admin' and not (target_user and str(target_user.id) == str(user.id)):
        if not guest_password and not host_approval:
            return buildResponse({"status": "failed", "error": "Security Policy: You must either set a Guest Password or require Host Approval to share a session."}, 400)

    join_payload = {
        "session_id": session_id,
        "token": token,
        "protocol": share_protocol,
        "participant_role": role,
        "participant_name": name,
        "user_id": str(target_user.id) if target_user else None,
        "guest_password": guest_password,
        "one_time": one_time,
        "host_approval": host_approval,
        "shared_by": str(user.id),
        "is_admin": is_admin_user,
        "share_type": share_type
    }
    r.setex(f"terminal_session:{token}", 300, json.dumps(join_payload))
    
    if target_user and send_notifications:
        # Send Email
        domain_url = db_sysconfig.get_sysconfig('domain_url')
        if not domain_url:
            domain_url = request.host_url
        link = f"{domain_url.rstrip('/')}/terminal-ws/winbox.html?token={token}" if is_winbox else f"{domain_url.rstrip('/')}/#/terminal-share?token={token}"
        invite_title = "WebBox Session Invite" if is_winbox else "Terminal Session Invite"
        invite_desc = f"You have been invited to join a {'WebBox' if is_winbox else 'terminal'} session as a {role}."
        msg = f"Hello {name},<br><br>{invite_desc}<br>Click <a href='{link}'>here</a> to join.<br><br>MikroWizard"
        send_email(target_user.email, invite_title, msg)
        
        # Send Alert
        if send_user_apprise:
            send_user_apprise(target_user, invite_title, f"{invite_desc} Link: {link}", source="terminal_share")
        
    return buildResponse({"status": "success", "share_url": share_url, "token": token, "protocol": share_protocol})


# ==================================================
# Session Recording — Admin Endpoints (Phase 4)
# ==================================================

@terminal_pro_api.route('/api/terminal/recording/list', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "read"})
def admin_list_recordings():
    """List recordings with optional filters (device, user, date range)."""
    user = get_myself()
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    blocked = _license_blocked()
    if blocked:
        return blocked
    device_id = request.json.get('device_id')
    user_id = request.json.get('user_id')
    date_from = request.json.get('date_from')
    date_to = request.json.get('date_to')
    page = int(request.json.get('page', 1))
    limit = int(request.json.get('limit', 50))
    q = TerminalSessionPro.select().where(
        TerminalSessionPro.recording_path.is_null(False),
        TerminalSessionPro.recording_path != ''
    )
    if device_id:
        q = q.where(TerminalSessionPro.device_id == device_id)
    if user_id:
        q = q.where(TerminalSessionPro.user_id == user_id)
    if date_from:
        q = q.where(TerminalSessionPro.started >= date_from)
    if date_to:
        q = q.where(TerminalSessionPro.started <= date_to)
    total = q.count()
    sessions = list(q.order_by(TerminalSessionPro.started.desc()).paginate(page, limit).dicts())
    
    for s in sessions:
        u = User.get_or_none(id=s['user_id'])
        s['user_name'] = f"{u.first_name} {u.last_name}" if u else s['user_id']
        
        d = db_device.Devices.get_or_none(id=s['device_id'])
        s['device_name'] = d.name if d else str(s['device_id'])
        s['device_ip'] = d.ip if d else "Unknown IP"
        
        s['protocol'] = _detect_session_protocol(s)
        
        if s.get('started') and hasattr(s['started'], 'strftime'):
            s['started_fmt'] = s['started'].strftime('%Y-%m-%d %H:%M:%S')

    return buildResponse({"status": "success", "data": sessions, "total": total})


@terminal_pro_api.route('/api/terminal/device/agent-config', methods=['POST'])
@login_required(role="admin", perm={"pam_session": "write"})
def device_agent_config():
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)

    device_id = request.json.get('device_id')
    agent_modes = request.json.get('agent_modes')

    if not device_id:
        return buildResponse({"status": "failed", "error": "device_id required"}, 400)

    # GET mode (no agent_modes in payload): just return current value
    if agent_modes is None and 'agent_modes' not in request.json:
        try:
            conn = DeviceConnections.get(
                DeviceConnections.device_id == device_id,
                DeviceConnections.protocol == 'ssh'
            )
            return buildResponse({"status": "success", "data": {"agent_modes": conn.agent_modes}})
        except DeviceConnections.DoesNotExist:
            return buildResponse({"status": "success", "data": {"agent_modes": None}})

    try:
        dev = db_device.Devices.get_by_id(device_id)
    except db_device.Devices.DoesNotExist:
        return buildResponse({"status": "failed", "error": "Device not found"}, 404)

    # Validate agent_modes before persisting (fail-closed per gateway contract)
    if isinstance(agent_modes, dict):
        valid, err = validate_agent_modes(agent_modes)
        if not valid:
            return buildResponse({"status": "failed", "error": err}, 400)

    try:
        conn = DeviceConnections.get(
            DeviceConnections.device_id == device_id,
            DeviceConnections.protocol == 'ssh'
        )
        conn.agent_modes = agent_modes if agent_modes is not None else None
        conn.modified = datetime.datetime.now()
        conn.save()
    except DeviceConnections.DoesNotExist:
        DeviceConnections.create(
            device_id=device_id,
            protocol='ssh',
            agent_modes=agent_modes if agent_modes is not None else None,
            created=datetime.datetime.now(),
            modified=datetime.datetime.now(),
        )

    return buildResponse({"status": "success", "data": {"agent_modes": agent_modes}})


def _resolve_recording_path(session_id):
    """Resolve recording filepath for a session, with Docker path fallback."""
    try:
        session = TerminalSessionPro.get_or_none(id=session_id)
        if not session or not session.recording_path:
            return None
    except Exception:
        return None
    recording_dir = config.srvconf.get('PYSRV_TERMINAL_RECORDINGS_DIR', '/opt/mikrowizard/terminal_recordings')
    if not os.path.exists(recording_dir) and recording_dir.startswith('/opt/mikrowizard/'):
        docker_dir = recording_dir.replace('/opt/mikrowizard/', '/conf/', 1)
        if os.path.exists(docker_dir):
            recording_dir = docker_dir
    filepath = os.path.join(recording_dir, session.recording_path)
    if not os.path.exists(filepath) and filepath.startswith('/opt/mikrowizard/'):
        docker_filepath = filepath.replace('/opt/mikrowizard/', '/conf/', 1)
        if os.path.exists(docker_filepath):
            filepath = docker_filepath
    return filepath if os.path.isfile(filepath) else None


@terminal_pro_api.route('/api/terminal/recording/cast/<session_id>', methods=['GET'])
def serve_cast_file(session_id):
    """Serve raw NDJSON asciicast file — player handles parsing natively."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    try:
        filepath = _resolve_recording_path(session_id)
        if not filepath:
            return buildResponse({"status": "failed", "error": "Recording file not found"}, 404)
        with open(filepath, 'rb') as f:
            cast_data = f.read()
        return Response(cast_data, mimetype='application/octet-stream')
    except TerminalSessionPro.DoesNotExist:
        return buildResponse({"status": "failed", "error": "Session not found"}, 404)


def _render_guac_player(session_id):
    """Render Guacamole Session Recording player HTML page."""
    html = f'''<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Remote Desktop Session Recording</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {{ box-sizing: border-box; margin: 0; padding: 0; }}
    body {{
      background: #0b0e14;
      color: #c9d1d9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }}
    #player-header {{
      height: 44px;
      background: #161b22;
      border-bottom: 1px solid #30363d;
      display: flex;
      align-items: center;
      padding: 0 16px;
      justify-content: space-between;
      flex-shrink: 0;
    }}
    .header-title {{
      font-size: 13px;
      font-weight: 600;
      color: #58a6ff;
      display: flex;
      align-items: center;
      gap: 8px;
    }}
    .header-badge {{
      background: #238636;
      color: #fff;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 4px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }}
    #display-container {{
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      overflow: hidden;
      position: relative;
    }}
    #display-target {{
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
    }}
    #display-target > div {{
      box-shadow: 0 4px 24px rgba(0,0,0,0.8);
    }}
    #loading-overlay {{
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(11, 14, 20, 0.95);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 10;
      gap: 12px;
    }}
    .spinner {{
      width: 36px;
      height: 36px;
      border: 3px solid #30363d;
      border-top-color: #58a6ff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }}
    @keyframes spin {{ to {{ transform: rotate(360deg); }} }}
    #controls-bar {{
      height: 50px;
      background: #161b22;
      border-top: 1px solid #30363d;
      display: flex;
      align-items: center;
      padding: 0 16px;
      gap: 10px;
      flex-shrink: 0;
    }}
    .ctrl-btn {{
      background: transparent;
      border: 1px solid #30363d;
      color: #c9d1d9;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 12px;
      transition: all 0.15s ease;
    }}
    .ctrl-btn:hover {{
      background: #21262d;
      border-color: #58a6ff;
      color: #58a6ff;
    }}
    #progress-container {{
      flex: 1;
      display: flex;
      align-items: center;
      gap: 10px;
    }}
    #seekbar {{
      flex: 1;
      height: 6px;
      border-radius: 3px;
      background: #30363d;
      outline: none;
      cursor: pointer;
      -webkit-appearance: none;
      accent-color: #58a6ff;
    }}
    #time-display {{
      font-size: 11px;
      font-family: monospace;
      color: #8b949e;
      min-width: 95px;
      text-align: right;
    }}
  </style>
</head>
<body>
  <div id="player-header">
    <div class="header-title">
      <i class="fab fa-windows"></i>
      <span>Remote Desktop Session Recording</span>
      <span class="header-badge">RECORDING</span>
    </div>
    <div style="font-size: 11px; color: #8b949e;">Session: {session_id}</div>
  </div>
  <div id="display-container">
    <div id="loading-overlay">
      <div class="spinner"></div>
      <div id="loading-text" style="font-size: 13px; color: #8b949e;">Loading session recording...</div>
    </div>
    <div id="display-target"></div>
  </div>
  <div id="controls-bar">
    <button class="ctrl-btn" id="btn-play" title="Play / Pause">
      <i class="fas fa-play" id="icon-play"></i>
    </button>
    <button class="ctrl-btn" id="btn-rw" title="Rewind 10s">
      <i class="fas fa-backward"></i>
    </button>
    <button class="ctrl-btn" id="btn-ff" title="Forward 10s">
      <i class="fas fa-forward"></i>
    </button>
    <div id="progress-container">
      <input type="range" id="seekbar" min="0" max="1000" value="0">
      <span id="time-display">00:00 / 00:00</span>
    </div>
    <button class="ctrl-btn" id="btn-fs" title="Fullscreen">
      <i class="fas fa-expand"></i>
    </button>
  </div>

  <script>
    var module = module || {{ exports: {{}} }};
  </script>
  <script src="/assets/libs/guacamole/guacamole-common.min.js"></script>
  <script>
    if (typeof Guacamole === 'undefined' && typeof module !== 'undefined' && module.exports && module.exports.SessionRecording) {{
      window.Guacamole = module.exports;
    }}
  </script>
  <script>
    let recording = null;
    let duration = 0;
    let isSeeking = false;

    function formatTime(ms) {{
      const totalSec = Math.floor(ms / 1000);
      const min = Math.floor(totalSec / 60);
      const sec = totalSec % 60;
      return String(min).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    }}

    function updateTimeDisplay(pos, dur) {{
      document.getElementById('time-display').textContent = formatTime(pos) + ' / ' + formatTime(dur);
    }}

    function scaleDisplay() {{
      if (!recording) return;
      const display = recording.getDisplay();
      if (!display) return;
      const container = document.getElementById('display-container');
      const cw = container.clientWidth;
      const ch = container.clientHeight;
      const dw = display.getWidth();
      const dh = display.getHeight();
      if (dw > 0 && dh > 0 && cw > 0 && ch > 0) {{
        const scale = Math.min(cw / dw, ch / dh);
        display.scale(scale);
      }}
    }}

    window.addEventListener('resize', scaleDisplay);

    fetch('/api/terminal/recording/guac/{session_id}')
      .then(resp => {{
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        return resp.blob();
      }})
      .then(blob => {{
        document.getElementById('loading-text').textContent = 'Parsing session data...';
        recording = new Guacamole.SessionRecording(blob);
        const display = recording.getDisplay();
        const target = document.getElementById('display-target');
        target.innerHTML = '';
        target.appendChild(display.getElement());

        display.onresize = function(width, height) {{
          scaleDisplay();
        }};

        recording.onload = function() {{
          duration = recording.getDuration();
          document.getElementById('loading-overlay').style.display = 'none';
          updateTimeDisplay(0, duration);
          scaleDisplay();
          recording.play();
          updatePlayIcon(true);
        }};

        recording.onplay = function() {{
          updatePlayIcon(true);
        }};

        recording.onpause = function() {{
          updatePlayIcon(false);
        }};

        recording.onseek = function(position) {{
          if (!isSeeking && duration > 0) {{
            document.getElementById('seekbar').value = Math.floor((position / duration) * 1000);
            updateTimeDisplay(position, duration);
          }}
        }};

        recording.onerror = function(err) {{
          document.getElementById('loading-text').textContent = 'Playback error: ' + err;
        }};

        setInterval(() => {{
          if (recording && !isSeeking && duration > 0) {{
            const pos = recording.getPosition();
            document.getElementById('seekbar').value = Math.floor((pos / duration) * 1000);
            updateTimeDisplay(pos, duration);
            if (!recording.isPlaying() && pos >= duration - 500) {{
              updatePlayIcon(false);
            }}
          }}
        }}, 250);
      }})
      .catch(err => {{
        document.getElementById('loading-text').textContent = 'Failed to load recording: ' + err.message;
      }});

    const btnPlay = document.getElementById('btn-play');
    const iconPlay = document.getElementById('icon-play');
    function updatePlayIcon(playing) {{
      if (playing) {{
        iconPlay.className = 'fas fa-pause';
      }} else {{
        iconPlay.className = 'fas fa-play';
      }}
    }}

    btnPlay.addEventListener('click', () => {{
      if (!recording) return;
      if (recording.isPlaying()) {{
        recording.pause();
      }} else {{
        if (recording.getPosition() >= duration - 200) {{
          recording.seek(0, () => recording.play());
        }} else {{
          recording.play();
        }}
      }}
    }});

    const seekbar = document.getElementById('seekbar');
    seekbar.addEventListener('mousedown', () => {{ isSeeking = true; }});
    seekbar.addEventListener('touchstart', () => {{ isSeeking = true; }});
    seekbar.addEventListener('input', (e) => {{
      if (duration > 0) {{
        const targetMs = (parseInt(e.target.value, 10) / 1000) * duration;
        updateTimeDisplay(targetMs, duration);
      }}
    }});
    function commitSeek(e) {{
      if (!recording || duration <= 0) return;
      isSeeking = false;
      const targetMs = (parseInt(e.target.value, 10) / 1000) * duration;
      recording.seek(Math.floor(targetMs), () => {{
        scaleDisplay();
      }});
    }}
    seekbar.addEventListener('mouseup', commitSeek);
    seekbar.addEventListener('touchend', commitSeek);

    document.getElementById('btn-rw').addEventListener('click', () => {{
      if (!recording || duration <= 0) return;
      const cur = recording.getPosition();
      recording.seek(Math.max(0, cur - 10000), () => {{ scaleDisplay(); }});
    }});

    document.getElementById('btn-ff').addEventListener('click', () => {{
      if (!recording || duration <= 0) return;
      const cur = recording.getPosition();
      recording.seek(Math.min(duration, cur + 10000), () => {{ scaleDisplay(); }});
    }});

    document.getElementById('btn-fs').addEventListener('click', () => {{
      const container = document.getElementById('display-container');
      if (!document.fullscreenElement) {{
        container.requestFullscreen().then(scaleDisplay).catch(() => {{}});
      }} else {{
        document.exitFullscreen().then(scaleDisplay).catch(() => {{}});
      }}
    }});
  </script>
</body>
</html>'''
    return html


@terminal_pro_api.route('/api/terminal/recording/guac/<session_id>', methods=['GET'])
@login_required(role="admin", perm={"pam_session": "read"})
def serve_guac_file(session_id):
    """Serve raw Guacamole recording (.guac) file."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    try:
        filepath = _resolve_recording_path(session_id)
        if not filepath:
            return buildResponse({"status": "failed", "error": "Recording file not found"}, 404)
        with open(filepath, 'rb') as f:
            data = f.read()
        return Response(data, mimetype='application/octet-stream')
    except Exception as e:
        return buildResponse({"status": "failed", "error": str(e)}, 500)


def _render_asciinema(filepath):
    """Render asciinema player HTML with inline cast data (reads file on server, avoids auth/CORS issues)."""
    try:
        with open(filepath, 'rb') as f:
            cast_bytes = f.read()
    except Exception as e:
        return f'<html><body><h3>Error reading recording: {e}</h3></body></html>'
   
    cast_b64 = base64.b64encode(cast_bytes).decode('ascii')
    html = f'''<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>MikroWizard - Session Recording</title>
  <link rel="stylesheet" href="/assets/libs/asciinema/asciinema-player.min.css">

</head>
<body>
  <div id="player"></div>
  <script src="/assets/libs/asciinema/asciinema-player.min.js"></script>
  <script>
    AsciinemaPlayer.create('data:application/octet-stream;base64,{cast_b64}', document.getElementById('player'));
  </script>
</body>
</html>'''
    return html


@terminal_pro_api.route('/api/terminal/recording/stream/<session_id>', methods=['GET'])
@login_required(role="admin", perm={"pam_session": "read"})
def stream_recording(session_id):
    """Serve asciinema player HTML page or HTML5 video player for a session recording."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    try:
        filepath = _resolve_recording_path(session_id)
        if not filepath:
            return buildResponse({"status": "failed", "error": "Recording file not found"}, 404)
        if filepath.endswith('.mp4'):
            html = f'''<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>WinBox Session Recording</title>
  <style>
    body {{ margin: 0; padding: 0; background: #0b0e14; display: flex; justify-content: center; align-items: center; height: 100vh; font-family: sans-serif; }}
    .video-container {{ width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }}
    video {{ max-width: 100%; max-height: 100%; outline: none; border-radius: 4px; box-shadow: 0 4px 20px rgba(0,0,0,0.6); }}
  </style>
</head>
<body>
  <div class="video-container">
    <video controls autoplay playsinline>
      <source src="/api/terminal/recording/video/{session_id}" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </div>
</body>
</html>'''
            resp = make_response(html)
            resp.headers['Content-Type'] = 'text/html; charset=utf-8'
            return resp
        elif filepath.endswith('.guac'):
            resp = make_response(_render_guac_player(session_id))
            resp.headers['Content-Type'] = 'text/html; charset=utf-8'
            return resp
        resp = make_response(_render_asciinema(filepath))
        resp.headers['Content-Type'] = 'text/html; charset=utf-8'
        return resp
    except TerminalSessionPro.DoesNotExist:
        return buildResponse({"status": "failed", "error": "Session not found"}, 404)


@terminal_pro_api.route('/api/terminal/recording/video/<session_id>', methods=['GET'])
@login_required(role="admin", perm={"pam_session": "read"})
def stream_video_file(session_id):
    """Stream MP4 recording file with HTTP Range support for scrubbing."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    if user.role not in ('admin', 'superuser'):
        return buildResponse({"status": "failed", "error": "Admin required"}, 403)
    try:
        filepath = _resolve_recording_path(session_id)
        if not filepath or not os.path.exists(filepath) or os.path.getsize(filepath) == 0:
            return buildResponse({"status": "failed", "error": "Recording file not found or empty"}, 404)

        file_size = os.path.getsize(filepath)
        range_header = request.headers.get('Range', None)
        if range_header:
            byte1, byte2 = 0, None
            m = re.search(r'bytes=(\d+)-(\d*)', range_header)
            if m:
                g = m.groups()
                byte1 = int(g[0])
                if g[1]:
                    byte2 = int(g[1])
            if byte1 >= file_size:
                resp = Response("Requested Range Not Satisfiable", 416)
                resp.headers['Content-Range'] = f'bytes */{file_size}'
                return resp
            if byte2 is None or byte2 >= file_size:
                byte2 = file_size - 1
            length = byte2 - byte1 + 1

            with open(filepath, 'rb') as f:
                f.seek(byte1)
                data = f.read(length)

            rv = Response(data, 206, mimetype='video/mp4', direct_passthrough=True)
            rv.headers['Content-Range'] = f'bytes {byte1}-{byte2}/{file_size}'
            rv.headers['Accept-Ranges'] = 'bytes'
            rv.headers['Content-Length'] = str(length)
            return rv
        else:
            with open(filepath, 'rb') as f:
                data = f.read()
            rv = Response(data, 200, mimetype='video/mp4')
            rv.headers['Accept-Ranges'] = 'bytes'
            rv.headers['Content-Length'] = str(file_size)
            return rv
    except Exception as e:
        log.error(f"Error streaming video for session {session_id}: {e}")
        return buildResponse({"status": "failed", "error": str(e)}, 500)

@terminal_pro_api.route('/api/terminal/gateway/status', methods=['GET'])
@login_required()
def gateway_status():
    """Check terminal gateway installation and capability status."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    installed = terminal_gateway.is_terminal_gateway_installed()
    webbox_supported, reason = terminal_gateway.is_webbox_supported()
    return buildResponse({
        "status": "success",
        "data": {
            "installed": installed,
            "webbox_supported": webbox_supported,
            "reason": reason,
            "install_doc_url": "https://mikrowizard.com/docs/installing-terminal-gatway-addon/",
            "update_doc_url": "https://mikrowizard.com/docs/updating-terminal-gateway-addon/"
        }
    })


@terminal_pro_api.route('/api/terminal/favorites', methods=['GET'])
@login_required()
def get_terminal_favorites():
    user = get_myself()
    if not user:
        return buildResponse({"error": "Unauthorized"}, 401)
    blocked = _license_blocked()
    if blocked:
        return blocked
    
    favs = list(TerminalFavoritePro.select().where(TerminalFavoritePro.user_id == user.id).order_by(TerminalFavoritePro.order_index).dicts())
    return buildResponse({"status": "success", "favorites": favs}, 200)

@terminal_pro_api.route('/api/terminal/favorites', methods=['POST'])
@login_required()
def save_terminal_favorites():
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    if not user:
        return buildResponse({"error": "Unauthorized"}, 401)
    
    try:
        
        
        data = request.json
        device_ids = data.get("favorites", [])  # list of device IDs in order
        
        with database.atomic():
            # Delete old favorites
            TerminalFavoritePro.delete().where(TerminalFavoritePro.user_id == user.id).execute()
            
            # Insert new favorites
            to_insert = []
            for i, dev_id in enumerate(device_ids):
                to_insert.append({
                    "user_id": user.id,
                    "device_id": int(dev_id),
                    "order_index": i
                })
            
            if to_insert:
                TerminalFavoritePro.insert_many(to_insert).execute()
                
        return buildResponse({"status": "success"}, 200)
    except Exception as e:
        log.error(f"Error saving terminal favorites: {e}")
        return buildResponse({"error": str(e)}, 500)


@app.route('/api/non-mikrotik/apps/publish', methods=['POST'])
@login_required(role="admin", perm={"device": "full"})
def publish_application():
    """Publish a child application under a parent host server in seconds (PRO feature)."""
    blocked = _license_blocked()
    if blocked:
        return blocked
    user = get_myself()
    data = request.json or {}
    parent_id = data.get('parent_id')
    name = (data.get('name') or '').strip()
    if not parent_id:
        return buildResponse({"status": "failed", "error": "parent_id is required"}, 400)
    if not name:
        return buildResponse({"status": "failed", "error": "Application name is required"}, 400)

    parent_dev = db_device.Devices.get_or_none(db_device.Devices.id == parent_id)
    if not parent_dev:
        return buildResponse({"status": "failed", "error": "Parent host device not found"}, 404)

    app_mode = data.get('app_mode', 'remote_app')
    remote_app = (data.get('remote_app') or '').strip()
    remote_app_dir = (data.get('remote_app_dir') or '').strip()
    remote_app_args = (data.get('remote_app_args') or '').strip()
    initial_program = (data.get('initial_program') or '').strip()
    template_id = data.get('template_id') or parent_dev.template_id

    protocol_config = {
        'app_mode': app_mode,
        'remote_app': remote_app,
        'remote_app_dir': remote_app_dir,
        'remote_app_args': remote_app_args,
        'initial_program': initial_program,
    }
    if 'overrides' in data and isinstance(data['overrides'], dict):
        protocol_config['overrides'] = data['overrides']

    now = datetime.datetime.now(datetime.timezone.utc)
    try:
        new_app = db_device.Devices.create(
            name=name, ip=None, mac="", details="{}", uptime="", license="", interface="",
            user_name="", password="", port="",
            update_availble=False, current_firmware="", arch="", sensors="",
            router_type="", wifi_config="", upgrade_avail=False,
            owner=user, created=now, modified=now, peer_ip="", failed_attempt=0,
            status="active", firmware_to_install="", syslog_configured=False, upgrade_device=False,
            device_type=parent_dev.device_type or "windows",
            device_model=parent_dev.device_model or "",
            template_id=template_id,
            parent_id=parent_dev.id,
            protocol_config=protocol_config
        )

        parent_conn = DeviceConnections.get_or_none(
            DeviceConnections.device_id == parent_dev.id,
            DeviceConnections.is_default == True
        ) or DeviceConnections.get_or_none(DeviceConnections.device_id == parent_dev.id)
        
        protocol = parent_conn.protocol if parent_conn else (data.get('protocol') or 'rdp')
        port = parent_conn.port if parent_conn else (3389 if protocol == 'rdp' else 5900)

        DeviceConnections.create(
            device_id=new_app.id,
            protocol=protocol,
            port=port,
            auth_mode='credential',
            is_default=True,
            created=now,
            modified=now,
            credential_id=parent_conn.credential_id if parent_conn else None
        )

        parent_groups = list(DevGroupRel.select().where(DevGroupRel.device_id == parent_dev.id))
        for pg in parent_groups:
            try:
                DevGroupRel.create(group_id=pg.group_id, device_id=new_app.id)
            except Exception:
                pass

        db_syslog.add_syslog_event(user, "Application", "Publish", get_ip(), get_agent(), json.dumps({
            "parent_id": parent_id, "app_name": name, "app_id": new_app.id
        }))
        return buildResponse({"status": "success", "id": new_app.id})
    except Exception as e:
        log.error(f"publish_application error: {e}")
        return buildResponse({"status": "failed", "error": str(e)}, 500)

app.register_blueprint(terminal_pro_api)
